# docker-compose 配置示例。复制为 .env 后按需修改:cp .env.example .env
# .env 含密钥,已被 .gitignore 忽略,切勿提交。

# 初始管理员口令(可选)。若留空,首次启动会走 Web 初始化向导(/setup)让你创建管理员;
# 填了则跳过向导、直接以此口令建 admin 账户。
ATOMGO_ADMIN_PASSWORD=change-me-please

# 凭据保险库主密钥:base64 编码的 32 字节。生成:
#   openssl rand -base64 32
# 留空则首次启动的 Web 向导可自动生成(仅展示一次,务必保存);或在向导里自选生成/自备。
# 一旦写入凭据,务必长期保存此 key —— 更换会导致已存凭据无法解密。
ATOMGO_MASTER_KEY=

# HTTP 监听地址(宿主侧)。默认 :7088。
ATOMGO_ADDR=:7088

# 反代后部署时填外部可访问 URL(webhook/OAuth 回跳用),如 https://ci.example.com
ATOMGO_PUBLIC_URL=

# ---- 数据库(默认 sqlite,落本地文件,无需任何配置)----
# 多数场景直接默认 SQLite 即可,首次启动向导也会默认选它。
# 如需 MySQL / PostgreSQL:既可以在此处设置下面两个变量(与 docker-compose 的
# --profile mysql/postgres 配合),也可以在首次启动的 Web 引导界面里直接选择并填写连接信息——
# 向导会自动把配置写入 atomgo.env,保存后自动重启生效,无需手动改文件。
# 切 MySQL:
# ATOMGO_DB_DRIVER=mysql
# ATOMGO_DB_DSN=atomgo:atomgo@tcp(mysql:3306)/atomgo?parseTime=true&charset=utf8mb4
# 切 PostgreSQL:
# ATOMGO_DB_DRIVER=postgres
# ATOMGO_DB_DSN=postgres://atomgo:atomgo@postgres:5432/atomgo?sslmode=disable
